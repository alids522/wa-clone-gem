<?xml version="1.0" encoding="utf-8"?>
<!--
  Backups are disabled for the app. These rules additionally keep the encrypted
  database, attachment cache and secure-storage blobs out of cloud/device
  transfers on API 31+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
